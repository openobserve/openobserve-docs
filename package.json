{
  "name": "openobserve-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "prebuild": "node scripts/copy-assets.mjs && node scripts/check-seo.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "dev": "node scripts/copy-assets.mjs && next dev -p 3030",
    "build": "next build",
    "postbuild": "node scripts/post-export.mjs && node scripts/check-links.mjs",
    "start": "next start",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.3.1",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.1",
    "fumadocs-ui": "^16.14.0",
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    }
  }
}
